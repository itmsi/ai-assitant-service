# ============================================================
# MEM0 MEMORY (menggantikan custom memory)
# ============================================================
# Mode deploy:
#   server  = self-hosted Mem0 REST server (Docker/production, Postgres+pgvector).
#             Server Mem0 memakai provider 'openai' yang OpenAI-compatible,
#             jadi dipakai SUMOPOD_API_KEY + SUMOPOD_BASE_URL (lihat docker-compose).
#   library = embedded mem0ai SDK, in-memory vector store + SQLite history.
#             Paling ringan untuk dev lokal TANPA Docker & TANPA Postgres.
#             Catatan: data in-memory hilang saat proses restart.
MEM0_MODE=library
# Master switch memory
MEM0_ENABLED=true
# Base URL Mem0 server (hanya dipakai saat MEM0_MODE=server).
# Lokal: http://localhost:8000 (atau 8888 jika via compose host port)
# Di dalam docker-compose otomatis di-override ke http://mem0:8000
MEM0_BASE_URL=http://localhost:8000
# X-API-Key untuk self-hosted server (dipakai sebagai ADMIN_API_KEY di container mem0).
# Wajib minimal 16 karakter. Kosongkan hanya jika AUTH_DISABLED=true di server.
MEM0_API_KEY=change-me-admin-key-min-16-chars
# JWT secret khusus server Mem0 (untuk container mem0 di docker-compose).
# Dipisah dari JWT_SECRET aplikasi utama. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MEM0_JWT_SECRET=change-me-mem0-jwt-secret-min-16-chars
# Admin API key untuk route /api/mosa/ai-assistant/memory (list/get/update/delete memory
# lintas user, admin only). Wajib dikirim via header X-Admin-Api-Key. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Kalau kosong, route /memory menolak semua request (fail closed).
MEMORY_ADMIN_API_KEY=change-me-memory-admin-key-min-16-chars
# Timeout request ke Mem0 (ms)
MEM0_TIMEOUT=30000
# Max memory yang di-inject ke system prompt
MEM0_MAX_INJECT=7
# Vector store library mode (MEM0_MODE=library):
#   memory   (default) → in-memory, zero infra, data hilang saat restart
#   pgvector → persistent di Postgres, butuh: CREATE EXTENSION vector; di DB target
MEM0_VECTOR_STORE=pgvector
# Kredensial PG untuk MEM0_VECTOR_STORE=pgvector (default ikut DB_*_DEV)
# MEM0_PG_CONNECTION_STRING=postgresql://user:pass@host:5432/db  (alternatif, mengalahkan field di bawah)
MEM0_PG_HOST=localhost
MEM0_PG_PORT=5432
MEM0_PG_USER=postgres
MEM0_PG_PASSWORD=postgres
MEM0_PG_DBNAME=ai_assistant
MEM0_PG_HNSW=false
# TTL hot cache Redis (detik) — 900 = 15 menit
MEM0_CACHE_TTL=900
# Hanya untuk MEM0_MODE=library: model LLM untuk extraction memory + path SQLite history
# (default otomatis ikut AI_MODEL_PROVIDER: sumopod → SUMOPOD_MODEL, selain itu → OPENAI_MODEL)
MEM0_LLM_MODEL=gpt-5.4
MEM0_HISTORY_DB_PATH=storages/mem0/history.db
# JWT secret untuk dashboard Mem0 (dipakai container mem0)
JWT_SECRET=change-me

# Rate Limiter Config
RATE_LIMIT_RETRY=100
RATE_LIMIT_MAX=100

