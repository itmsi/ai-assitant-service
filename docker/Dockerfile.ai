FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --only=production && npm cache clean --force

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p logs

# Expose port (default AI Assistant port)
EXPOSE 9588

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:9588/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Start AI Assistant standalone server
CMD ["node", "src/modules/ai_assistant/server.js"]
